<Window x:Class="DexBridge.PhoneFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DexBridge file transfer" Height="620" Width="720" MinHeight="460" MinWidth="600"
        WindowStartupLocation="CenterOwner" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" Icon="Assets/dexbridge-logo.png">
    <Grid Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" Text="Phone files" FontSize="22" FontWeight="SemiBold"
                   ToolTip="Transfer files between Galaxy storage and Windows using the bundled ADB connection."/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Padding="12,6" Margin="0,0,8,0" Click="Up_Click">Up</Button>
            <TextBox x:Name="PathBox" Grid.Column="1" MinHeight="30" VerticalContentAlignment="Center" Text="/sdcard/Download" KeyDown="PathBox_KeyDown"/>
            <Button Grid.Column="2" Padding="12,6" Margin="8,0,0,0" Click="Go_Click">Go</Button>
            <Button Grid.Column="3" Padding="12,6" Margin="8,0,0,0" Click="Refresh_Click">Refresh</Button>
        </Grid>

        <ListView x:Name="FileList" Grid.Row="2" MouseDoubleClick="FileList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="470" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Ready"/>
            <Button Grid.Column="1" Padding="14,7" Margin="8,0" Click="Download_Click">Download to PC…</Button>
            <Button Grid.Column="2" Padding="14,7" Click="Upload_Click">Upload from PC…</Button>
        </Grid>
    </Grid>
</Window>
