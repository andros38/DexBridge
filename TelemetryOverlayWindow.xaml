<Window x:Class="DexBridge.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MaxWidth="900" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" ShowActivated="False" Icon="Assets/dexbridge-logo.png">
    <Border Background="#EE0D0D0D" CornerRadius="9" Padding="14,8" BorderBrush="#55FFFFFF" BorderThickness="1">
        <TextBlock x:Name="TelemetryText" Foreground="White" FontSize="14" FontWeight="SemiBold" Text="DexBridge" TextTrimming="CharacterEllipsis" MaxWidth="860"/>
    </Border>
</Window>
